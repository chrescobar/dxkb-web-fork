<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('header') %>
	</head>
	<body onunload="" class="claro patric <% if (request.isAuthenticated && request.isAuthenticated()) { %>Authenticated<% } %>" style="display:flex;flex-direction:column;height:100vh;overflow:hidden;">
		<div id="ApplicationContainer" data-dojo-type="dijit/layout/BorderContainer" class="layoutContainer" data-dojo-props="id:'ApplicationContainer',gutters:false,liveSplitters:false" style="padding-bottom: 20px;overflow: hidden !important; background-color: var(--cepi-bone);flex:1;min-height:0;">
			<%- include('bv-brc-header') %>

			<div data-dojo-type="dijit/layout/ContentPane" data-dojo-props="region:'center'" style="padding:0px;border:0px solid #ddd;background:inherit;" id="centerContent">

			</div>
			<!-- <div data-dojo-type="p3/widget/WorkspaceController" data-dojo-props="region:'bottom'"></div> -->

		</div>

		<div style="flex-shrink:0;">
			<%- include('bv-brc-footer') %>
		</div>
		<div data-dojo-type="p3/widget/copilot/ChatButton" data-dojo-props="id:'chatButton'"></div>
		<%- include('javascript') %>
	</body>
</html>
